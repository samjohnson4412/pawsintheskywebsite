---
/** Renders Q&A. Pass the same array to BaseLayout `faqs` for the schema. */
import type { Faq } from '../layouts/BaseLayout.astro';
interface Props { faqs: Faq[]; title?: string }
const { faqs, title = 'Questions people ask' } = Astro.props;
---
<section class="section">
  <div class="wrap prose">
    <h2>{title}</h2>
    {faqs.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <div><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</section>
