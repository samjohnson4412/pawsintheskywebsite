---
import Logo from './Logo.astro';
import { CREDENTIALS, FOOTER_LINKS, ORG } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <Logo tone="light" />
      <p>{ORG.tagline} Based in {ORG.city}, {ORG.region}. Flying pets across the U.S.</p>
      <p>
        <a href={`mailto:${ORG.email}`}>{ORG.email}</a>
        {ORG.phone && <><br /><a href={`tel:${ORG.phoneHref}`}>{ORG.phone}</a></>}
      </p>
    </div>
    {FOOTER_LINKS.map((group) => (
      <nav aria-label={group.heading}>
        <h2>{group.heading}</h2>
        <ul>
          {group.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>

  <div class="wrap legal">
    <p>
      © {year} {ORG.legalBrand}, a division of {ORG.parent}
      {CREDENTIALS.usdaCertificate && <> · USDA-registered animal transporter, certificate {CREDENTIALS.usdaCertificate}</>}
    </p>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-900); color: rgb(255 255 255 / 0.82); padding-top: var(--space-lg); font-size: var(--step--1); }
  .cols { display: grid; gap: 2rem; grid-template-columns: 2fr repeat(3, 1fr); }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  .about p { max-width: 36ch; margin-top: 1rem; }
  h2 { font: 700 var(--step--1) / 1 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--cyan-500); margin-bottom: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li + li { margin-top: 0.45rem; }
  a { color: rgb(255 255 255 / 0.88); text-decoration: none; }
  a:hover { color: var(--white); text-decoration: underline; }
  .legal { border-top: 1px solid rgb(255 255 255 / 0.12); margin-top: var(--space-md); padding-block: 1.25rem; color: rgb(255 255 255 / 0.6); }
  .legal p { margin: 0; }
</style>
