---
import type { Review } from '../data/reviews';
interface Props { reviews: Review[] }
const { reviews } = Astro.props;
---
<div class="reviews">
  {reviews.map((r) => (
    <figure class="card review">
      <blockquote><p>“{r.quote}”</p></blockquote>
      <figcaption><strong>{r.name}</strong><span>{r.trip}</span></figcaption>
    </figure>
  ))}
</div>
<style>
  .reviews { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: start; }
  .review { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; }
  figcaption { display: grid; font-size: var(--step--1); color: var(--color-text-muted); }
  figcaption strong { color: var(--ink); }
</style>
