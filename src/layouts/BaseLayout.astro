---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ORG } from '../consts';

export interface Crumb { href: string; label: string }
export interface Faq { q: string; a: string }

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Breadcrumb trail, excluding Home. Emitted as BreadcrumbList schema. */
  crumbs?: Crumb[];
  /** Questions answered on the page. Emitted as FAQPage schema. */
  faqs?: Faq[];
  /** Extra JSON-LD nodes (e.g. Article for guides). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image = '/brand/og-default.png', crumbs = [], faqs = [], schema = [], noindex = false } =
  Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = title === ORG.name ? title : `${title} | ${ORG.name}`;

const business = {
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', site).href,
  name: ORG.name,
  url: site.href,
  logo: new URL('/brand/logo.png', site).href,
  description: 'In-cabin pet flight nanny and pet transport service based in Tampa, Florida.',
  image: ogImage,
  email: ORG.email,
  ...(ORG.phone ? { telephone: ORG.phone } : {}),
  // City only: the registered address is a residence and is not published.
  address: { '@type': 'PostalAddress', addressLocality: ORG.city, addressRegion: ORG.region, addressCountry: 'US' },
  areaServed: ORG.areaServed.map((name) => ({ '@type': 'Place', name })),
  parentOrganization: { '@type': 'Organization', name: ORG.parent },
  sameAs: [...Object.values(ORG.social), ORG.citizenShipper].filter(Boolean),
};

const graph: Record<string, unknown>[] = [business, ...schema];
if (crumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ href: '/', label: 'Home' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href, site).href,
    })),
  });
}
if (faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2d61ad" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ORG.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Inter:wght@400;600;650;700&display=swap"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
