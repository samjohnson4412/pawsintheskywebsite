---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import { CREDENTIALS, ORG } from '../consts';
import { FAQ_BASICS } from '../data/faqs';
import { REVIEWS } from '../data/reviews';
import { PHOTOS } from '../data/photos';
import ReviewList from '../components/ReviewList.astro';

const INCLUDED = [
  { title: 'In the cabin, never cargo', body: 'Your pet rides in a carrier at our feet for the whole flight, with a person beside them who is there only for them.' },
  { title: 'Updates the whole way', body: 'GPS tracking and photos from pickup to hand-off, sent to you and anyone else you name.' },
  { title: 'Confirmed flights', body: 'You know the flight numbers and arrival time before travel day, so whoever is collecting can plan.' },
  { title: 'Delays covered', body: 'If a cancellation strands us overnight, your pet stays with us and you pay nothing extra.' },
];

const faqs = FAQ_BASICS.slice(0, 5);
---

<BaseLayout
  title="In-Cabin Pet Flight Nanny Service"
  description="Paws In The Sky flies your dog or cat in the airline cabin — never cargo — with a USDA-registered courier, GPS tracking and photo updates. Based in Tampa, flying across the U.S. and abroad."
  faqs={faqs}
>
  <section class="home-hero">
    <div class="wrap grid-hero">
      <div>
        <p class="eyebrow">Pet flight nanny · Tampa, FL</p>
        <h1>Your pet flies in the cabin, with a person, the whole way.</h1>
        <p class="lede">
          We fly with your dog or cat as a passenger: at our feet, never in cargo.
          You get photo updates and live tracking from pickup to the hand-off at the other end.
        </p>
        <div class="btn-row">
          <a class="btn" href="/quote/">Get a quote</a>
          <a class="btn btn--ghost" href="/how-it-works/">How it works</a>
        </div>
        <p class="reassure">
          {CREDENTIALS.usdaCertificate && <span class="badge">USDA-registered · {CREDENTIALS.usdaCertificate}</span>}
          {CREDENTIALS.liabilityInsurance && <span class="badge">{CREDENTIALS.liabilityInsurance} liability insurance</span>}
        </p>
      </div>
      <figure class="hero-photo">
        <img src={PHOTOS.corgi.src} alt={PHOTOS.corgi.alt} width="800" height="1000" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What every trip includes</p>
        <h2>One courier, one pet, one flight plan you can see.</h2>
      </div>
      <div class="grid">
        {INCLUDED.map((i) => (
          <div class="card"><h3>{i.title}</h3><p>{i.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow">Recent passengers</p>
      <div class="passengers">
        {[PHOTOS.chocolate, PHOTOS.black, PHOTOS.doodle].map((ph) => (
          <img src={ph.src} alt={ph.alt} width="800" height="1000" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap grid grid--2 split">
      <div>
        <p class="eyebrow">Who we fly for</p>
        <h2>New puppies, moving families, and the breeders in between.</h2>
        <p>
          Most of our trips bring a puppy or kitten from a breeder to a new family in another state.
          Others move a family’s cat or dog when a plane ticket for the whole household doesn’t line up,
          or when the pet is too precious to send as freight.
        </p>
        <p>
          Breeders: we keep you and the buyer updated from the same trip, so nobody is chasing anyone for news.
          <a href="/breeders/">Working with breeders</a>.
        </p>
      </div>
      <ol class="steps">
        <li><h3>Tell us about the trip</h3><p>Where from, where to, when, and your pet’s size.</p></li>
        <li><h3>Get a quote for the whole trip</h3><p>Flights, the airline’s pet fee and our time, in one number.</p></li>
        <li><h3>Book the vet</h3><p>Your pet needs a health certificate, usually within 10 days of travel.</p></li>
        <li><h3>Hand off, then follow along</h3><p>Photos and tracking until your pet is in the arms of whoever is collecting.</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Reviews</p>
        <h2>“He texted the whole entire journey.”</h2>
      </div>
      <ReviewList reviews={REVIEWS.filter((r) => r.featured)} />
      <p class="more-reviews"><a href="/reviews/">Read all reviews</a> · <a href={ORG.citizenShipper} rel="noopener">on CitizenShipper</a></p>
    </div>
  </section>

  <FaqList faqs={faqs} />

  <CtaBand />
</BaseLayout>

<style>
  .home-hero { padding-block: clamp(3rem, 7vw, 6rem); background: linear-gradient(180deg, var(--white), var(--sand-100)); }
  .grid-hero { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: center; }
  .home-hero h1 { max-width: 17ch; }
  .reassure { margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .hero-photo { margin: 0; max-width: 400px; justify-self: center; }
  .hero-photo img { display: block; width: 100%; height: auto; border-radius: 28px; box-shadow: var(--shadow); }
  @media (max-width: 860px) {
    .grid-hero { grid-template-columns: 1fr; }
    .hero-photo { max-width: 240px; order: -1; }
  }
  .passengers { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
  .passengers img { width: 100%; height: auto; border-radius: var(--radius); display: block; }
  @media (max-width: 600px) { .passengers { grid-template-columns: repeat(3, 1fr); gap: 0.5rem; } }
  .split { align-items: center; gap: 2.5rem; }
  .more-reviews { margin-top: 1.5rem; font-weight: 600; }
</style>
